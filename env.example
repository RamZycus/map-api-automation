# Environment Variables Template
# Copy this file to .env and fill in your actual values

# MAP API Configuration
BASE_URL=http://hpx-up1.app.inmu.qc.zycus.local:39405
API_KEY=your-api-key-here

# Chat API Configuration
CHAT_API_URL=http://hpx-up1.app.inmu.qc.zycus.local:39405/chat-api

# Ably Configuration
ABLY_API_KEY=your-ably-api-key-here
ABLY_CHANNEL=your-ably-channel-name

# Test Configuration
NODE_ENV=development
TEST_TIMEOUT=30000
TEST_RETRIES=3

# Optional: Database Configuration (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=test_db
# DB_USER=test_user
# DB_PASSWORD=test_password
